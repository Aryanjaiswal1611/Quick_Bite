# Leave empty to use same-origin + Vite proxy in development
# In production (separate hosts), set full API origin, e.g. https://api.example.com
VITE_API_URL=

# Used only by Vite dev proxy when VITE_API_URL is empty
VITE_BACKEND_PORT=8000
# Or set full proxy target:
# VITE_PROXY_TARGET=http://localhost:8000
