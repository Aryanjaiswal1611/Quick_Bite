# ── ⚠️ CRITICAL for Production (Vercel) ──────────────────────────────────────
# Set this to your Render backend URL. Example:
#   VITE_API_URL=https://quickbite-api.onrender.com
# Leave empty for local development (uses Vite proxy in vite.config.js)
# If you see "Failed to fetch" or CORS errors in production, this is #1 cause.
VITE_API_URL=

# ── Google OAuth (required for Google Login button) ───────────────────────────
# Only needed if Google Login is implemented on frontend.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── EmailJS (optional) ───────────────────────────────────────────────────────
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ── Development Only ─────────────────────────────────────────────────────────
VITE_BACKEND_PORT=8000
# VITE_PROXY_TARGET=http://localhost:8000
