# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/food_delivery
# Atlas: mongodb+srv://user:password@cluster.xxxxx.mongodb.net/food_delivery
MONGO_URI=mongodb://localhost:27017/food_delivery

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
SESSION_SECRET=change_me_to_a_long_random_string

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: *  (reflects request origin with credentials)
# Production:  https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# ── Google OAuth (required for Google Login) ─────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# CLIENT_URL=https://your-frontend.vercel.app

# ── Razorpay (optional) ──────────────────────────────────────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
