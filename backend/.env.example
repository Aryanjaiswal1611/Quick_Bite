# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Render sets PORT automatically — do NOT override
PORT=8000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# ⚠️ CRITICAL: Use your MongoDB Atlas connection string in production.
# Atlas: mongodb+srv://user:password@cluster.xxxxx.mongodb.net/food_delivery?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/food_delivery

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
SESSION_SECRET=change_me_to_a_long_random_string

# ── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGIN=* (default) → reflects request origin → works with ANY frontend URL.
#   You do NOT need to set this for basic production deployment.
# CORS_ORIGIN=https://your-app.vercel.app → restricts to specific origins.
#   Comma-separate multiple origins if needed.
CORS_ORIGIN=*

# ── CLIENT_URL ────────────────────────────────────────────────────────────────
# Used as an additional allowed origin when CORS_ORIGIN is explicitly set.
# Not needed when CORS_ORIGIN=*.
# CLIENT_URL=https://your-app.vercel.app

# ── Google OAuth (required for Google Login button) ───────────────────────────
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Razorpay (optional — test keys work for development) ──────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
