# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Render sets PORT automatically — do NOT override
PORT=8000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# ⚠️ CRITICAL: Use your MongoDB Atlas connection string in production.
# Atlas format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/food_delivery?retryWrites=true&w=majority
# If your password contains special characters, URL-encode them before using the URI.
# Example: @ => %40, # => %23, : => %3A, / => %2F, ? => %3F
MONGO_URI=mongodb://localhost:27017/food_delivery

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
SESSION_SECRET=change_me_to_a_long_random_string

# ── CORS ─────────────────────────────────────────────────────────────────────
# For production, set to comma-separated allowed origins (no trailing slashes).
# Example: CORS_ORIGIN=https://quick-bite-drab-mu.vercel.app,https://quick-bite-git-main-aryan1611.vercel.app
# '*' = reflect any origin (dev only — NOT secure for production with credentials)
CORS_ORIGIN=https://quick-bite-drab-mu.vercel.app

# ── CLIENT_URL ────────────────────────────────────────────────────────────────
# Used as an additional allowed origin. Comma-separate multiple URLs.
CLIENT_URL=https://quick-bite-drab-mu.vercel.app

# ── Google OAuth (required for Google Login button) ───────────────────────────
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Razorpay (optional — test keys work for development) ──────────────────────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx